# ============================================================
#  CONFIGURACIÓN ERP PRODUCCIÓN TEXTIL / INDUSTRIAL
#  Copiar este archivo como .env para pruebas locales.
#  En Render: Configurar estas variables en el panel "Environment".
# ============================================================

# ── Django Core ─────────────────────────────────────────────
DEPLOYMENT_ENV=development
SECRET_KEY=generar-con-secrets-token_urlsafe-50
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ── Base de Datos PostgreSQL (Ubuntu local o Supabase) ──────
# Dejar comentado para usar SQLite localmente.
# Para PostgreSQL local en Ubuntu:
# DATABASE_URL=postgresql://erp:CAMBIAR_PASSWORD@127.0.0.1:5432/erp_produccion_textil
# En Render / Producción con Supabase: colocar la cadena URI con SSL:
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# O usando el Session Pooler (puerto 5432) o Transaction Pooler (puerto 6543):
# DATABASE_URL=postgresql://postgres.[TU_PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL_REQUIRE=False
# En producción use DEPLOYMENT_ENV=production, DJANGO_DEBUG=False y HTTPS.
# Respaldo manual: python manage.py backup_db --output-dir=/var/backups/erp

# ── Empresa ──────────────────────────────────────────────────
EMPRESA_NOMBRE=Fábrica de Producción Textil Venezolana S.A.

# ── Correo Electrónico (Opcional) ───────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para producción con SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
